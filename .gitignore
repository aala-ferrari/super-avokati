.env
venv/
__pycache__/
*.pyc
*.pyo
.DS_Store
.pytest_cache/
.ruff_cache/
logs/
*.log
# Local mini-git snapshots (scripts/snapshot.py) — not pushed to remote
.snapshots/
# Data is tracked on purpose: the snapshot ships with articles + decisions
# already parsed and indexed, so the app runs immediately after clone/build.
# The live user database and session secret are instance-local — never commit.
data/app.db
data/app.db-journal
data/.secret_key
# Per-case lawyer uploads (PDFs, images) — private client material, never commit.
data/uploads/
# Raw scraped decisions — ~345 MB of .doc/.pdf/.html. Regenerable via
# `python -m src.scrapers.run`; Case.full_text in legalkb holds the parsed text.
data/raw/
# Claude Code local state
.claude/

# Scarti delle patch fatte sul VPS: arrivano con rsync, non vanno in git
*.bak-*
*.bak.py
src.bak-*/
