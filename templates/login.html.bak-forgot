<body class="login-page">

<svg width="0" height="0" style="position:absolute" aria-hidden="true">
  <defs>
    <symbol id="icon-scales" viewBox="0 0 80 80">
      <g class="scales-pillar">
        <line x1="40" y1="14" x2="40" y2="66" stroke="currentColor" stroke-width="3" stroke-linecap="round"/>
        <rect x="28" y="64" width="24" height="5" rx="1.5" fill="currentColor"/>
        <circle cx="40" cy="12" r="3.5" fill="#c9a24d"/>
      </g>
      <line x1="12" y1="22" x2="68" y2="22" stroke="currentColor" stroke-width="3" stroke-linecap="round"/>
      <g class="scales-pan scales-pan-left">
        <line x1="12" y1="22" x2="12" y2="30" stroke="currentColor" stroke-width="1.5"/>
        <path d="M 4 32 Q 12 42 20 32 Z" fill="currentColor" opacity="0.92"/>
      </g>
      <g class="scales-pan scales-pan-right">
        <line x1="68" y1="22" x2="68" y2="30" stroke="currentColor" stroke-width="1.5"/>
        <path d="M 60 32 Q 68 42 76 32 Z" fill="currentColor" opacity="0.92"/>
      </g>
    </symbol>
  </defs>
</svg>

<div class="login-wrap">
  <div class="login-card">
    <div class="logo login-logo">
      <svg class="logo-svg" viewBox="0 0 80 80" aria-hidden="true"><use href="#icon-scales"/></svg>
      <div class="logo-glow" aria-hidden="true"></div>
    </div>
    <h1>Super Avokati</h1>
    <p class="login-tagline">Beteja fitohet para se të nisë.</p>

    <form id="login-form" class="login-form" autocomplete="on">
      <label>
        <span>Përdoruesi</span>
        <input type="text" id="login-username" name="username"
               autocomplete="username" autocapitalize="none"
               required autofocus />
      </label>
      <label>
        <span>Fjalëkalimi</span>
        <input type="password" id="login-password" name="password"
               autocomplete="current-password" required />
      </label>
      <button type="submit" id="login-btn" class="primary">Hyr</button>
      <div id="login-error" class="login-error" hidden></div>
    </form>

    <div class="login-footer">
      Aksesi është i rezervuar — kontakto administratorin nëse nuk ke kredenciale.
    </div>
  </div>
</div>

<script src="/static/login.js"></script>
</body>
</html>
