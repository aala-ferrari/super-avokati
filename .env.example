# ── Brain selection ───────────────────────────────────────────────
# "auto" prefers Claude Code CLI (subscription — best quality, no per-token cost),
# then Gemini (free tier), then Anthropic API.
# Or force: BRAIN_BACKEND=claude_code | gemini | anthropic
BRAIN_BACKEND=auto

# ── Claude Code (RECOMMENDED: uses your Claude subscription) ──────
# Requires the `claude` CLI installed and `claude /login` completed.
# No API key, no per-token billing. Supports native conversation context
# via `--resume`.
#
# Pinned to the smartest flagship: Opus 4.8 (current top-tier Claude)
# + Sonnet 4.6 for the fast analytical stages (Haiku rimosso — niente
# modelli "piccoli" in uno strumento legale). Full IDs (not aliases)
# so the choice is explicit and immune to alias remapping.
# This assistant defends real cases for people who can't afford a
# lawyer — accuracy and strategic depth beat latency every time.
CLAUDE_CODE_MODEL=claude-opus-4-8
CLAUDE_CODE_FAST_MODEL=claude-sonnet-4-6
# Extended thinking effort for the MAIN answer stage (low / medium /
# high / xhigh / max). Triage + strategic stay fast (Sonnet, no effort).
# Empty string disables thinking entirely.
CLAUDE_CODE_EFFORT=max

# ── Gemini (FREE: ~1500 requests/day on 2.5 Flash) ────────────────
# Get a key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro
GEMINI_FAST_MODEL=gemini-2.5-flash

# ── Anthropic Claude (paid, highest quality) ─────────────────────
# Get a key at: https://console.anthropic.com
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-4-8
CLAUDE_FAST_MODEL=claude-sonnet-4-6
# Extended thinking budget (tokens) for the main model on the Anthropic
# API backend. Applies to the final answer only. Set to 0 to disable.
CLAUDE_THINKING_BUDGET=16000

# ── Telegram ─────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=

# ── Paths / tuning ───────────────────────────────────────────────
INDEX_PATH=./data/index
RAW_DATA_PATH=./data/raw
PROCESSED_DATA_PATH=./data/processed
APP_DB_PATH=./data/app.db
UPLOAD_PATH=./data/uploads
LOG_PATH=./logs/super_avvocato.log
TOP_K_ARTICLES=12
TOP_K_DECISIONS=4
MAX_CONVERSATION_TURNS=20

# ── Pipeline parallelism (V7.5) ──────────────────────────────────
# Analytical stages fan out in a thread pool. WORKERS caps how many
# stage lambdas run at once; CLAUDE_CODE_MAX_CONCURRENCY caps how
# many `claude -p` subprocesses are in flight simultaneously
# (enforced by a semaphore shared across all ClaudeCodeBackend calls).
# Keep them aligned — workers > concurrency just blocks uselessly.
BRAIN_PARALLEL_STAGES=1
BRAIN_PARALLEL_WORKERS=3
CLAUDE_CODE_MAX_CONCURRENCY=3

# Short-followup fast path: when the user is in an active Claude Code
# session (≥2 prior turns) and asks a short follow-up under this many
# chars with no new dossier, skip triage + retrieval + the 11 parallel
# analytical stages and answer via --resume directly. Set to 0 to
# disable.
FOLLOWUP_FASTPATH_MAX_CHARS=200

# Simple-query fast path (V7.6): triage classifies each fresh question
# as "simple" or "complex". On "simple" (informative, no adversary, no
# deadline, no dossier) we skip the 11 analytical stages + precedent
# retrieval + urgency/action_plan and go straight to compose on Opus —
# ~50-90s instead of 3-6 min. Complex queries still get the full
# war-room. Set to 0 to force full pipeline on every query.
SIMPLE_FASTPATH_ENABLED=1

# ── Dossier (per-case uploaded files) ────────────────────────────
# Hard limits protect both disk and LLM context budget.
MAX_UPLOAD_SIZE_MB=25
MAX_DOCUMENTS_PER_CASE=20
# Char-budget for a single document fed into the brain prompt.
DOC_CONTEXT_CHAR_BUDGET=6000

# ── Web server ───────────────────────────────────────────────────
HOST=127.0.0.1
PORT=5050
# Flask signing key for session cookies. Leave empty to auto-generate a
# persistent secret under data/.secret_key — set explicitly in production
# to share a secret across multiple instances behind a load balancer.
SECRET_KEY=
