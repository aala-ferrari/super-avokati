.git
.gitignore
.dockerignore
venv/
__pycache__/
**/__pycache__/
*.pyc
*.pyo
.pytest_cache/
.DS_Store
logs/
*.log
.env
tests/
# Raw jurisprudence files are only needed to rebuild the index — the image
# ships the already-built bm25 pickles and the parsed jsonl, so the ~74MB of
# raw PDFs/DOCX are excluded to keep the image small.
data/raw/
# User database and session secret are host-local — mount them as a volume
# at runtime instead of baking them into the image.
data/app.db
data/.secret_key
# Per-case uploads are volume-mounted at runtime.
data/uploads/

# Backup di lavoro (*.bak-*): restano sull'host come punti di ritorno,
# ma non devono finire nell'immagine — sono copie intere di web.py/app.js
# che pesano ~10MB senza essere mai servite.
*.bak*
**/*.bak*
src.bak-*
